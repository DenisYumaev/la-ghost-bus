# Copy to backend.hcl (gitignored) and fill in the bucket from:
#   terraform -chdir=infra/bootstrap output tfstate_bucket_name
# Then: terraform -chdir=infra init -backend-config=backend.hcl
bucket       = "la-ghost-bus-tfstate-<account-id>"
key          = "infra/terraform.tfstate"
region       = "us-west-2"
profile      = "default"
use_lockfile = true
encrypt      = true
